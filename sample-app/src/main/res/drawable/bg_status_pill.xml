<?xml version="1.0" encoding="utf-8"?>
<!-- Base shape for the status pill — actual fill color is set at runtime
     per-state (resolving/matched/not-matched/error) via GradientDrawable.setColor,
     see MainActivity.setStatusPill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="@color/status_not_matched_bg" />
</shape>
